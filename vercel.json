{
  "rewrites": [
    { "source": "/", "destination": "/index.htm" },
    { "source": "/blog", "destination": "/index.htm" },
    { "source": "/blog/:slug", "destination": "/index.htm" },
    { "source": "/admin", "destination": "/index.htm" },
    { "source": "/admin/:path*", "destination": "/index.htm" }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/assets/admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
